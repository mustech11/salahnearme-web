# Server-only Supabase monitoring
SUPABASE_PROJECT_REF=
SUPABASE_MANAGEMENT_ACCESS_TOKEN=

# Public production site URL used by the homepage health check
NEXT_PUBLIC_SITE_URL=https://www.salahnearme.com

# Configured quota limits
SUPABASE_EGRESS_QUOTA_GB=250
SUPABASE_DATABASE_QUOTA_GB=8
SUPABASE_STORAGE_QUOTA_GB=

# Optional current usage values.
# Batch 1 automatically calculates percentages from these values.
# Leave blank rather than entering 0 when the value is unknown.
SUPABASE_EGRESS_USED_GB=
SUPABASE_DATABASE_USED_GB=
SUPABASE_STORAGE_USED_GB=
